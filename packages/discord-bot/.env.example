# Discord Bot Environment Configuration

# Required: Your Discord bot token (from Discord Developer Portal)
TOKEN=your_token_here

# Optional: Target Discord Channel ID for daily problem announcements (defaults to 1084131482123112559)
CHANNEL_ID=1084131482123112559

# Optional: LeetCode API Base URL (defaults to https://leetcode-api.klenir.com or http://localhost:50520)
LEETCODE_API_URL=https://leetcode-api.klenir.com

# Optional: Cron schedule for daily problem broadcasts (defaults to "0 11 * * *" - 11:00 AM daily)
CRON_SCHEDULE=0 11 * * *

# Optional: Passcode for skip-daily admin command (defaults to 4444)
ADMIN_PASSCODE=4444

# Optional: Enable auto git pull / PM2 restart background task (defaults to false)
ENABLE_AUTO_DEPLOY=false
